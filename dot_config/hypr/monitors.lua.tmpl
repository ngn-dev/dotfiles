-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
--
-- Per-machine blocks are selected by hostname at `chezmoi apply`.

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
{{ if eq .chezmoi.hostname "ngn-oma" -}}
-- Desktop: 4K main display, 1080p secondary
hl.monitor({ output = "DP-1", mode = "3840x2160@240", position = "auto", scale = omarchy_gdk_scale })
hl.monitor({ output = "DP-2", mode = "1920x1080@240", position = "auto" })
{{ else -}}
-- Unknown machine: Omarchy's default, every output at its preferred mode
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })
{{ end -}}
